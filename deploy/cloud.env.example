# Template only. Actual values belong in /srv/rankstein/secrets/runtime.env (0600).
RANKSTEIN_CLOUD_PRODUCTION_ENABLED=0
RANKSTEIN_CLOUD_DAILY_AT=06:30
RANKSTEIN_CLOUD_TIMEZONE=Africa/Casablanca
RANKSTEIN_CLOUD_CAMPAIGN_TIMEOUT_SECONDS=3600
RANKSTEIN_HERMES_CODEX_URL=http://127.0.0.1:8642/v1
