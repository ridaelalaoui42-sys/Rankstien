RANKSTEIN_MIN_MEMORY_GB=1
RANKSTEIN_MAX_MEMORY_PERCENT=95
RANKSTEIN_MAX_QUEUE_DAYS=3
# Account identities must match the private domain manifests. No password in JSON.
PINTEREST_ACCOUNTS=[{"name":"rida","session":"pinterest_rida_cloud","email_env":"PINTEREST_RIDA_EMAIL","password_env":"PINTEREST_RIDA_PASSWORD","browser":"chromium"},{"name":"media","session":"pinterest_media_cloud","email_env":"PINTEREST_MEDIA_EMAIL","password_env":"PINTEREST_MEDIA_PASSWORD","browser":"chromium"}]
PINTEREST_DOMAIN_ACCOUNT_MAP={"recetadolce":["rida"],"recetagenial":["media"]}
PINTEREST_RIDA_EMAIL=
PINTEREST_RIDA_PASSWORD=
PINTEREST_MEDIA_EMAIL=
