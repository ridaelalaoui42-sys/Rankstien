# Use a verified custom domain only at launch. Preview stays noindex.
NEXT_PUBLIC_SITE_URL=

# Must be a NEW dedicated Stitch Atlas Supabase project, NOT either recipe project.
# Leave empty in preview until the project's budget and organization are confirmed.
NEXT_PUBLIC_CROCHET_SUPABASE_URL=
NEXT_PUBLIC_CROCHET_SUPABASE_ANON_KEY=

# Two separate publication gates. Keep false until real editorial testing and approval.
CROCHET_PUBLISHING_ENABLED=false

# Optional FREE Firebase Spark Google sign-in + Firestore user-owned cloud progress.
# Set ALL FOUR values from ONE dedicated Firebase Web App to activate.
# No credentials/secrets; these are client SDK identifiers. Firestore rules MUST be deployed.
# Never enable Google login on a domain not listed in Firebase Authentication's authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
