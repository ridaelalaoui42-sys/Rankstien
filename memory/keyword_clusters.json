  "internal_linking_rules": {
    "min_internal_links_per_article": 3,
    "max_internal_links_per_article": 7,
    "mandatory_links": [
      {
        "type": "category_pillar",
        "description": "Every article must link to its category page",
        "pattern": "/categoria/{category_slug}"
      },
      {
        "type": "same_cluster",
        "description": "Link to 2-3 articles within the same cluster",
        "count": "2-3"
      },
      {
        "type": "cross_cluster",
        "description": "Link to 1 article from a related cluster",
        "count": 1
      }
    ],
    "authority_links": {
      "frequency": "every 3rd article",
      "targets": ["/seguridad-alimentaria", "/guia-higiene"]
    },
    "anchor_text_rules": {
      "avoid": ["click here", "aquí", "ver más"],
      "prefer": "descriptive keyword-rich anchors matching target article title"
    }
  },
  "external_link_policy": {
    "always_use": {
      "target": "_blank",
      "rel": "noopener noreferrer nofollow"
    },
    "trusted_domains": [
