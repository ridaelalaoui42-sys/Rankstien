# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets.

# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── RankStein Internal ────────────────────────────
CMS_API_KEY=your-cms-api-key
ADMIN_PASSWORD=your-admin-password
RANKSTEIN_SECRET=your-rankstein-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEBUG=true

# ── Google AI / Gemini ────────────────────────────
# Hermes Codex is the default article-generation provider. RankStein calls the
# local Hermes OpenAI-compatible API, which is backed by openai-codex/gpt-5.5.
# Gemini/Odysseus/OpenRouter remain fallbacks only.
RANKSTEIN_AI_ENGINE=gemini_cli
RANKSTEIN_ARTICLE_PROVIDER=hermes-codex-first-free
RANKSTEIN_HERMES_CODEX_URL=http://127.0.0.1:8642/v1
RANKSTEIN_HERMES_CODEX_MODEL=Hermes Agent
RANKSTEIN_CODEX_IMAGE_QUALITY=medium
RANKSTEIN_POLLINATIONS_MODEL=flux
RANKSTEIN_HERMES_CODEX_TIMEOUT=900

# Gemini CLI subscription/OAuth is a fallback image/article helper.
# Authenticate once with the Gemini CLI on this machine, then leave API-key
# values empty unless a legacy standalone script explicitly needs them.
ADK_MODEL=auto
RANKSTEIN_FALLBACK_MODEL=gemini-3.1-pro-preview
GEMINI_CLI_PATH=
GEMINI_CLI_TIMEOUT_SECONDS=300
GEMINI_CLI_YOLO=true

# Optional API-key path for AgentMemory LLM/embeddings and legacy scripts.
NANOBANANA_API_KEY=
# Gemini CLI uses OAuth/subscription auth. Do not set GEMINI_API_KEY or GOOGLE_API_KEY for CLI runs.

# ── Pinterest Credentials ─────────────────────────
PINTEREST_EMAIL=your-pinterest-email
PINTEREST_PASSWORD=your-pinterest-password

# Production browser and queue limits
PINTEREST_DEFAULT_BROWSER=chromium
PINTEREST_CHROMIUM_CHANNEL=chrome
PINTEREST_WORKER_COUNT=2
PINTEREST_MAX_WORKERS=2
PINTEREST_MAX_SESSIONS=2
PINTEREST_SESSION_TTL_MINUTES=360
PINTEREST_BASE_DELAY=30
PINTEREST_HOURLY_LIMIT=6
PINTEREST_BURST_LIMIT=2
PINTEREST_DAILY_LIMIT=50
PINTEREST_CROSS_SAVE_LIMIT=0
PINTEREST_DOMAIN_ACCOUNT_MAP={"recetadolce":["rida"],"recetagenial":["media"]}
PINTEREST_PUBLIC_USERNAME_MAP={"rida":"your_rida_username","media":"your_media_username"}
PINTEREST_ACCOUNT_BOARD_MAP={"media":{"ENSALADES":"Ensaladas y Saludable","Aperitivos":"Aperitivos y Tapas","Chocolate":"Postres y Dulces","Arroces":"Arroces y Paellas","Carnes":"Carnes y Tradici\u00f3n","Fresas":"recetas fresas","Pescados":"recetas"}}
